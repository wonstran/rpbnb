^Rcodes$
^data$
^docs$
^\.git$
^\.gitignore$
^\.claude$
^\.superpowers$
^\.agents$
^pics$
^.*\.Rproj$
^\.Rproj\.user$
^LICENSE\.md$
^comments$
^results$
^tools$
^\.github$
^AGENTS\.md$
^RPBNB_PARAMETERS_GUIDE\.md$
^build_reference\.R$
^generate_manual\.R$
