^build_windows_binary\.R$
# Build outputs, not sources. Without these the tarball ships ~7.8 MB of
# previously built copies of itself (packages/*.zip, packages/*.tar.gz), the
# raw data archive, and the rendered vignette PDF -- roughly 16x the real
# package. tests/results holds CSVs regenerated by tests/bnb_rwm1984.R.
^packages$
^data\.zip$
^vignettes/.*\.pdf$
^tests/results$
^\.posit/assistant$
# Hand-written design docs and the TMB reference manual, carried over from the
# rpbnb.tmb merge. NOT under docs/, which is pkgdown output that build_site()
# cleans.
^dev-docs$
# Local research data -- large and deliberately not published. Both are also
# gitignored; keeping them out of the tarball as well.
^inst/extdata/export_.*_all\.csv$
