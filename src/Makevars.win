# Makevars.win for rpbnb (Windows/Rtools). One DLL, two engines.
#
# On Rtools, $(SHLIB_OPENMP_CXXLIBS) can expand to empty, dropping -fopenmp from
# the link step (undefined reference to GOMP_*). Use SHLIB_OPENMP_CXXFLAGS for
# PKG_LIBS as well so -fopenmp is present at link and GCC pulls in libgomp.
#
# -Wa,-mbig-obj is required by the TMB translation unit, which exceeds the COFF
# 32767-section limit. It applies to the Rcpp kernels too; that is harmless.
#
# CXX17 is required by TMB (CppAD / TMBad).
#
# $(TMB_CXXFLAGS)/$(TMB_LIBS) are deliberately omitted -- see src/Makevars.

CXX_STD = CXX17
PKG_CXXFLAGS = -Wa,-mbig-obj $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS)
